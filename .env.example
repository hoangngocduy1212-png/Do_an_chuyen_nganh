# ---------- MongoDB ----------
# Docker: host la 'mongo'. Chay ngoai Docker: mongodb://localhost:27017/supermarket
MONGODB_URI=mongodb://mongo:27017/supermarket
# Tương thích với ai-service đang dùng tên MONGO_URI.
MONGO_URI=mongodb://mongo:27017/supermarket

# ---------- Backend (NestJS) ----------
BACKEND_PORT=3000
JWT_ACCESS_SECRET=dev-only-access-secret-replace-with-at-least-32-characters
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_COST=12
FRONTEND_URL=http://localhost:5173
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Muadee <no-reply@muadee.vn>
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=8000

# Cổng thanh toán / vận chuyển (điền khi tích hợp)
PAYMENT_QR_API_KEY=
PAYMENT_CARD_API_KEY=
CARRIER_API_KEY=

# ---------- AI Service (FastAPI) ----------
AI_SERVICE_PORT=8000
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
INTERNAL_API_KEY=khoa-noi-bo-backend-goi-ai

# ---------- Frontend (React) ----------
VITE_API_URL=/api/v1

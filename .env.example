# ---------- MongoDB ----------
# Chạy ngoài Docker: MongoDB Community local hoặc Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/supermarket?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Docker Compose ghi đè URI thành hostname dịch vụ mongo.
MONGO_URI=mongodb://127.0.0.1:27017/supermarket?replicaSet=rs0

# ---------- Backend (NestJS) ----------
BACKEND_PORT=3000
JWT_ACCESS_SECRET=dev-only-access-secret-replace-with-at-least-32-characters
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_COST=12
FRONTEND_URL=http://localhost:5173
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Muadee <no-reply@muadee.vn>
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=60000

# Thanh toán (dùng VietQR; webhook HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
PAYMENT_CARD_CHECKOUT_URL=
PAYMENT_CARD_API_KEY=
CARRIER_API_KEY=

# ---------- AI Service (FastAPI) ----------
AI_SERVICE_PORT=8000
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
INTERNAL_API_KEY=khoa-noi-bo-backend-goi-ai

# ---------- Quy tắc kinh doanh ----------
FREE_SHIP_THRESHOLD=200000
DEFAULT_SHIPPING_FEE=20000

# ---------- Frontend (React) ----------
VITE_API_URL=/api/v1

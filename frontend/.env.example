# Dev: de trong de dung proxy cua Vite (/api -> localhost:3000)
VITE_API_URL=/api/v1
VITE_USE_MOCK=false

# Mo phong cac kich ban B2C; dat VITE_USE_MOCK=true de bat.
VITE_MOCK_CART_MODE=multiple
VITE_MOCK_ORDER_CREATE_MODE=normal
VITE_MOCK_VOUCHER_MODE=normal
VITE_MOCK_TRANSFER_STATUS=PENDING
VITE_MOCK_CARD_STATUS=PENDING
VITE_MOCK_TRACKING_MODE=normal
VITE_MOCK_DELIVERY_ADDRESS_MODE=auto
